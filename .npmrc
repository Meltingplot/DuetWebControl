# @duet3d/connectors 3.7.1-alpha.1 asks for @duet3d/objectmodel ~3.7.1-alpha.1 as a peer, which the
# 3.7.2-alpha.1 that upstream DWC uses does not satisfy, and no newer connectors package exists yet.
# Without this, npm ci and npm install stop with ERESOLVE. Remove it once the peer range fits again.
legacy-peer-deps=true
